--- !u!114 &2140611977
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2140611975}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\n\n\n\n\n\n\n\n\n\n\nOctavio Ferrer muri\xF3 aquella noche, pero no lo
    derrotaste solo.\r\n\r\nTom\xE1s eligi\xF3 enfrentarse a su padre y te mostr\xF3
    el camino hacia la salida. Sin su ayuda, jam\xE1s habr\xEDas escapado de aquella
    casa.\r\n\r\nSin embargo, los experimentos hab\xEDan cambiado su cuerpo para
    siempre. Afuera no lo esperaba una vida normal, sino el miedo de quienes nunca
    entender\xEDan en qu\xE9 se hab\xEDa convertido.\r\n\r\nAntes del amanecer, Tom\xE1s
    desapareci\xF3.\r\n\r\nNunca revelaste que segu\xEDa con vida.\r\n\r\nEscapaste
    de la casa gracias a \xE9l.\r\n\r\nPero Tom\xE1s jam\xE1s pudo escapar de lo
    que su padre le hab\xEDa hecho.\r\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nHAUNTED HOUSE\n\nUna
    experiencia desarrollada por\n\nLuz Rubini\nJulieta Margenants\n\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nProgramaci\xF3n\n\nJulieta
    Margenants\nLuz Rubini\n\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nDise\xF1o
    de Juego\n\nLuz Rubini\nJulieta Margenants\n\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nNarrativa\n\nJulieta
    Margenants\nLuz Rubini\n\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nDise\xF1o
    de Niveles\n\nLuz Rubini\nJulieta Margenants\n\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nModelos
    3D y Animaciones\n\nSketchfab\nMixamo\n\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nArte
    asistido por IA\n\nOpenAI\nInteligencia Artificial\n\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nM\xFAsica
    y efectos de sonido\n\nPixabay\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nMotores
    Graficos II\nUniversidad Abierta Interamericana\nLicenciatura en\nDesarrollo
    de Simuladores y Videojuegos\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nGracias
    por jugar."
